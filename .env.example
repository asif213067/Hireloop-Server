# Mongo connection string
MONGODB_CLIENT=
# Database name shared with the Better Auth client
MONGODB_NAME=
# Better Auth base URL; must match the client's value exactly (used as JWT issuer/audience)
BETTER_AUTH_URL=
# Comma-separated CORS origins, e.g. http://localhost:3000,https://hireloop.example
CLIENT_URL=
# Server port
PORT=
# Optional proxy trust: true, 1, a hop count, loopback, linklocal or uniquelocal
TRUST_PROXY=
